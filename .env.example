# Copy this to .env.local and fill in real values: cp .env.example .env.local
#
# Without MONGODB_URI the app starts in LOCAL MODE during development:
# demo login (no GitHub account needed), data stored in .data/moodify.json.
# In production builds (next start) local mode must be enabled explicitly:
# MOODIFY_LOCAL_MODE=true

# MongoDB connection string (entries, habits and NextAuth sessions)
MONGODB_URI=mongodb://localhost:27017/moodify

# NextAuth (Auth.js v5): random secret, e.g. from `npx auth secret`
AUTH_SECRET=replace-with-a-random-secret

# GitHub OAuth app for sign-in (https://github.com/settings/developers)
AUTH_GITHUB_ID=your-github-client-id
AUTH_GITHUB_SECRET=your-github-client-secret
